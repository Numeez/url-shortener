POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

REDIS_PORT=6379

# Host port the app container is published on, and the base URL used to build short links.
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# 256-bit base64 key, e.g. `openssl rand -base64 32`. Must be overridden in real deployments.
JWT_SECRET=change-me-to-a-256-bit-base64-secret
JWT_EXPIRATION_MS=86400000

# Optional: if both are set, an ADMIN user is created (or an existing user with this
# email is promoted to ADMIN) on startup. Leave blank to skip.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
